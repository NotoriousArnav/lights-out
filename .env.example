# Clerk — https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk routes (must be VITE_ prefixed so the client can read them)
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Server-side signing key for game tokens. Generate one with:
#   openssl rand -hex 32
PUZZLE_SECRET=replace_with_a_long_random_string

# Development database. SQLite is used locally; production uses Postgres.
DATABASE_URL=file:./.data/lights-out.db
